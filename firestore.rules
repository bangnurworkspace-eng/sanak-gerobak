rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bangnurworkspace@gmail.com' ||
        request.auth.token.email.lower() == 'bangnurworkspace@gmail.com' ||
        request.auth.uid == 'svJZt6OptUR2GK9DNncOslUJ9ds2'
      );
    }

    function isVerifiedAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isVerifiedAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow create, update: if isVerifiedAdmin() || (isSignedIn() && request.auth.uid == adminId && isBootstrappedAdmin());
      allow delete: if isVerifiedAdmin() && request.auth.uid != adminId;
    }

    // Site Sections (Hero, Brand Statement, Services, Local, FAQ, Contact, Settings)
    match /site_sections/{sectionId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Site Content legacy / fallback alias
    match /site_content/{sectionId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isVerifiedAdmin() || resource == null || resource.data.status == 'published' || !('status' in resource.data);
      allow write: if isVerifiedAdmin();
    }

    // Portfolio showcase
    match /portfolio/{portfolioId} {
      allow read: if isVerifiedAdmin() || resource == null || resource.data.status == 'published' || !('status' in resource.data);
      allow write: if isVerifiedAdmin();
    }

    // Categories taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    // Media library records
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }

    match /media_library/{mediaId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
  }
}
